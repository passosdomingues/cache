digraph G {
    fontname="Helvetica,Arial,sans-serif"
    node [fontname="Helvetica,Arial,sans-serif", shape=box, style="rounded,filled", fillcolor="#f9f9f9"]
    edge [fontname="Helvetica,Arial,sans-serif"]
    rankdir=LR

    subgraph cluster_python {
        label = "Pipeline Python (Dupla B)";
        style = "filled";
        color = "#e8f4f8";
        runner [label="runner_and_plot.py\n(Orquestrador)", fillcolor="#cce5ff"];
        generator [label="generator.py\n(Gerador de Grafos Erdos-Renyi)", fillcolor="#cce5ff"];
        matplotlib [label="Matplotlib\n(Plotagem de Resultados)", fillcolor="#cce5ff"];
    }

    subgraph cluster_c {
        label = "Core Algorítmico C (Dupla A)";
        style = "filled";
        color = "#e8f8e8";
        base [label="base.c\n(Leitura de Matriz e Profiling)", fillcolor="#d4edda"];
        algorithms [label="algorithms.c", fillcolor="#d4edda"];
        dijkstra [label="Dijkstra\nO(m log n)", shape=ellipse, fillcolor="#c3e6cb"];
        bmssp [label="BMSSP (Duan)\nO(m log^{2/3} n)", shape=ellipse, fillcolor="#c3e6cb"];
        bellman [label="Bellman-Ford\nBaseline", shape=ellipse, fillcolor="#c3e6cb"];
    }

    subgraph cluster_latex {
        label = "Documentação (Dupla C)";
        style = "filled";
        color = "#f8e8f8";
        sbc [label="sbc-template.tex\n(Relatório SBC)", fillcolor="#e2d9f3"];
        beamer [label="apresentacao.tex\n(Apresentação Beamer)", fillcolor="#e2d9f3"];
    }

    Makefile [label="Makefile Top-Level\n(Automação 'make all')", shape=hexagon, fillcolor="#fff3cd"];
    tempdat [label="temp.dat\n(Instância de Grafo Temporária)", shape=note];
    pngout [label="desempenho_algoritmos_pb.png\n(Gráfico 300 DPI)", shape=note];

    Makefile -> runner [label=" chama"];
    Makefile -> sbc [label=" compila"];
    Makefile -> beamer [label=" compila"];
    Makefile -> base [label=" compila (gcc)"];

    runner -> generator [label=" executa para N"];
    generator -> tempdat [label=" escreve stdout"];
    tempdat -> base [label=" lido por"];
    
    base -> algorithms [label=" importa"];
    algorithms -> dijkstra;
    algorithms -> bmssp;
    algorithms -> bellman;
    
    base -> runner [label=" retorna stdout\n(Tempos)"];
    runner -> matplotlib [label=" passa tempos"];
    matplotlib -> pngout [label=" gera"];
    
    pngout -> sbc [label=" embutido em"];
    pngout -> beamer [label=" embutido em"];
}
